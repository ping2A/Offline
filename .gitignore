flutter/.idea/
flutter/*.log
flutter/web/pkg/
**/.metadata

# iOS / macOS CocoaPods & Xcode local state (also covered under flutter/ios/.gitignore)
**/Pods/
**/DerivedData/
**/xcuserdata/

# Android local SDK path & signing material
**/local.properties
**/key.properties
**/*.keystore
**/*.jks

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
*.iml

# Secrets / env
.env
.env.*
!.env.example
