# Rust
debug/
target/
**/*.rs.bk
*.pdb
**/mutants.out*/

# Flutter
flutter/.dart_tool/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/.packages
flutter/build/
flutter/.pub-cache/
flutter/.pub/
flutter/coverage/
